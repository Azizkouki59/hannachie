{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "hannachie",
  "compatibility_date": "2026-01-01",
  "main": "worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
